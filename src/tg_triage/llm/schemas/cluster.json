{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["summary", "problem_ids"],
        "properties": {
          "summary": { "type": "string" },
          "problem_ids": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "integer" }
          }
        }
      }
    }
  }
}
